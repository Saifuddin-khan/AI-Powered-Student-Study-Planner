# ================================================================
# Smart Study Planner — Environment Variables
# ================================================================
# Copy this file, rename it to .env, and fill in your values.
# NEVER commit your actual .env file to version control.
# ================================================================

# --- DATABASE ---
DB_URL=jdbc:mysql://localhost:3306/student_study_planner?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- JWT ---
# Must be a 256-bit (64 hex chars) secret key
JWT_SECRET=your_64_character_hex_secret_key_here

# --- EMAIL (Gmail SMTP) ---
# Set MAIL_ENABLED=true to actually send emails; false = OTP logged to console only
MAIL_ENABLED=false
# Use a Gmail App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- AI (OpenAI) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- FILE STORAGE (optional, defaults to uploads/profile-images) ---
# FILE_UPLOAD_DIR=uploads/profile-images

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin seed (created on first startup) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_password

# --- Server ---
APP_BASE_URL=http://localhost:8080
PORT=8080
